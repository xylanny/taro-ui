{
  "name": "@taro-ui/workspace",
  "version": "0.0.1",
  "private": true,
  "description": "one component lib created mainly by Vue3 + TS!",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "docs": "pnpm --filter @taro-ui/docs docs",
    "storybook": "pnpm --filter @taro-ui/play storybook",
    "typecheck": "vue-tsc -b",
    "test": "pnpm -r test",
    "coverage": "pnpm -r coverage",
    "build": "pnpm --filter @taro-ui/vue build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.0",
    "postcss-each": "^1.1.0",
    "postcss-each-variables": "^0.3.0",
    "postcss-for": "^2.1.1",
    "postcss-nested": "^6.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@taro-ui/hooks": "workspace:*",
    "@taro-ui/theme": "workspace:*",
    "@taro-ui/utils": "workspace:*",
    "@taro-ui/vue": "workspace:*",
    "lodash-es": "^4.18.1",
    "vue": "^3.5.42"
  }
}
