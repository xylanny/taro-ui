{
  "name": "taro-ui",
  "version": "0.0.2",
  "description": "one component lib created mainly by Vue3 + TS!",
  "type": "module",
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "unpkg": "./dist/umd/index.umd.cjs",
  "jsdelivr": "./dist/umd/index.umd.cjs",
  "types": "./dist/types/core/index.d.ts",
  "style": "./dist/es/index.css",
  "exports": {
    ".": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/es/index.js"
    },
    "./style.css": "./dist/es/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build:es": "vite build --config vite.es.config.ts",
    "build:umd": "vite build --config vite.umd.config.ts",
    "build": "pnpm run clean && pnpm run build:es && pnpm run build:umd",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@taro-ui/components": "workspace:*",
    "@taro-ui/theme": "workspace:*",
    "@taro-ui/utils": "workspace:*",
    "rimraf": "^6.1.3",
    "vite-plugin-dts": "5.0.3"
  }
}
